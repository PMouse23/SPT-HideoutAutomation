<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.3.2</Version>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>HideoutAutomation.Server</AssemblyName>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <OutputPath>$(MSBuildProjectDirectory)\..\dist\SPT_Runtime\user\mods\HideoutAutomation.Server\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.6" PrivateAssets="all" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.6" PrivateAssets="all" />
    <PackageReference Include="SPTushonka.Reflection" Version="4.1.6" PrivateAssets="all" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" PrivateAssets="all" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ModMetadata.cs;HideoutAutomationRouter.cs;HideoutAutomationService.cs;Models\**\*.cs;Stores\**\*.cs;OnLoad.cs;OnUpdate.cs;Patches\**\*.cs" />
    <ProjectReference Include="..\HideoutAutomation.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>
</Project>
